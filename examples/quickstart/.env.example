# Copy to .env before starting the stack.
#
# These starting values are deliberately weak so that `rotator scan` flags
# them; the point of the example is to watch them get replaced.

POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme

# Passphrase encrypting the rotation history. Generate your own:
#   openssl rand -base64 32
ROTATOR_MASTER_KEY=replace-me-with-a-long-random-passphrase

# gid of the docker socket on this host:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
